NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Neon / Supabase (PostgreSQL) — voir README pour la marche à suivre
# Connexion directe (requise par Prisma Migrate)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Connexion poolée (PgBouncer), utilisée par l'app au runtime
DATABASE_URL_POOLED="postgresql://user:password@host-pooler:5432/dbname?sslmode=require&pgbouncer=true"

# Secret JWT — générer une valeur aléatoire forte, ex: openssl rand -hex 48
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# AWS S3 — upload vidéo par URLs pré-signées, voir README pour la marche à suivre
AWS_REGION="eu-west-3"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"
AWS_S3_BUCKET="change-me"
