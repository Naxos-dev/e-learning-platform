NODE_ENV=test
PORT=4001
CORS_ORIGIN=http://localhost:5173

# Branche Neon dédiée aux tests (jamais la base de dev/prod) — Console Neon → Branches → Create branch
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler:5432/dbname?sslmode=require&pgbouncer=true"

JWT_SECRET="test-secret-key-at-least-32-characters-long-0000"
JWT_EXPIRES_IN="1h"

# Valeurs factices : le SDK S3 est mocké dans les tests, aucun appel réseau réel
AWS_REGION="eu-west-3"
AWS_ACCESS_KEY_ID="test-access-key-id"
AWS_SECRET_ACCESS_KEY="test-secret-access-key"
AWS_S3_BUCKET="test-bucket"
